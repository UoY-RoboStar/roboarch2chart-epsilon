@lazy
rule PlannerSchedulerLayerToStateMachinesAndConnections
	transform amlyr: RoboArch!PlanningLayer
	to rcstms: Set(RoboChart!StateMachine), rccons: Set(RoboChart!Connection) {
	
		guard : amlyr.pattern.isTypeOf( RoboArch!PlannerScheduler )
		
		printDebug("Start");
		
		//TODO generate plannerscheduler robochart model
		var stm = new RoboChart!StateMachineDef;
		stm.nodes = Set{};
		stm.transitions = Set{};
		
		var initialNode = new RoboChart!Initial;
		initialNode.name = "initial";
		stm.nodes.add(initialNode);
		
		var stateNode = new RoboChart!State;
		stateNode.name = "s0";
		stm.nodes.add(stateNode);
		
		var trans = new RoboChart!Transition;
		trans.name = "intialTos0";
		trans.source = initialNode;
		trans.target = stateNode;
		stm.transitions.add(trans);
		
		rcstms.add(stm);
	}