//			var trigger = new RoboChart!Communication;
//			trigger.event = VerificationInfoExecuteEventsIface.events.select( ev | ev.name == ("get_" + v.name + "_Execute") ).first();
//			trigger._type = RoboChart!CommunicationType#SIMPLE;
//			t.trigger = trigger;
//			// action: var!var
//			var action = new RoboChart!CommunicationStmt;
//			action.communication = new RoboChart!Communication;
//			action.communication.event = VerificationInfoExecuteEventsIface.events.select( ev | ev.name == (v.name  + "_Execute") ).first();
//			action.communication._type = RoboChart!CommunicationType#OUTPUT;
//			action.communication.value = new RefExp;
//			action.communication.value.ref = v;
//			t.action = action;
//			result.transitions.add(t);
//		}
//	}
	
	// make state machine package
	var rcpkg = new RoboChart!RCPackage;
	rcpkg.name = result.name;
	rcpkg.machines = Set{};
	rcpkg.machines.add(result);
	
	var packageImport = new RoboChart!Import;
	packageImport.importedNamespace = DefinitionsName() + rc_importall();
	printDebug(rcpkg.name + ": adding import of " + packageImport.importedNamespace);
	rcpkg.imports.add( packageImport );
	
	return result;
}
	
	