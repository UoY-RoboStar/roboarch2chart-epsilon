		action.communication = new RoboChart!Communication;
		action.communication.event = PlanDataExtEventsIface.events.select( ev | ev.name == (v.name + "_ext") ).first();
		action.communication._type = RoboChart!CommunicationType#OUTPUT;
		action.communication.value = new RefExp;
		action.communication.value.ref = v;
