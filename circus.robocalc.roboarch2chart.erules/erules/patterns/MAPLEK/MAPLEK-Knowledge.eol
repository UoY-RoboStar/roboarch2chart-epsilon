		result.interfaces.add(AnalysisResultsLegitimateEventsIface);
		
		for (v in AnalysisResultsIface.variableList.collect( vl | vl.vars).flatten()) {
			// get_analysisResults_Legitimate transitions
			var t = new RoboChart!Transition;
			t.name = v.name + "_get_Legitimate_trans";
			t.source = KnowledgeState;
			t.target = KnowledgeState;
			// trigger: get_var
			var trigger = new RoboChart!Communication;
			trigger.event = AnalysisResultsLegitimateEventsIface.events.select( ev | ev.name == ("get_" + v.name + "_Legitimate") ).first();
			trigger._type = RoboChart!CommunicationType#SIMPLE;
			t.trigger = trigger;
			// action: var!var
			var action = new RoboChart!CommunicationStmt;
			action.communication = new RoboChart!Communication;
			action.communication.event = AnalysisResultsLegitimateEventsIface.events.select( ev | ev.name == (v.name  + "_Legitimate") ).first();
			action.communication._type = RoboChart!CommunicationType#OUTPUT;
			action.communication.value = new RefExp;
			action.communication.value.ref = v;
			t.action = action;
			result.transitions.add(t);
		}
	}
	
	// add PlanData events and transitions
	var PlanDataEventsIface = ref(lyrName + "_PlanData_events", RoboChart!Interface);
	result.interfaces.add(PlanDataEventsIface);
	var PlanDataSetEventsIface = ref(lyrName + "_PlanData_set_events", RoboChart!Interface);
	result.interfaces.add(PlanDataSetEventsIface);
	var PlanDataExtEventsIface = ref(lyrName + "_PlanData_ext_events", RoboChart!Interface);
	result.interfaces.add(PlanDataExtEventsIface);
	for (v in PlanDataIface.variableList.collect( vl | vl.vars).flatten()) {
		// get_planData transitions
		var t = new RoboChart!Transition;
		t.name = v.name + "_get_trans";
		t.source = KnowledgeState;
		t.target = KnowledgeState;
		// trigger: get_var
		var trigger = new RoboChart!Communication;
		trigger.event = PlanDataEventsIface.events.select( ev | ev.name == ("get_" + v.name) ).first();
		trigger._type = RoboChart!CommunicationType#SIMPLE;
		t.trigger = trigger;
		// action: var!var
		var action = new RoboChart!CommunicationStmt;
		action.communication = new RoboChart!Communication;
		action.communication.event = PlanDataEventsIface.events.select( ev | ev.name == v.name ).first();
		action.communication._type = RoboChart!CommunicationType#OUTPUT;
		action.communication.value = new RefExp;
		action.communication.value.ref = v;
		t.action = action;
		result.transitions.add(t);
		
		// set_planData transitions
		var t = new RoboChart!Transition;
		t.name = v.name + "_set_trans";
		t.source = KnowledgeState;
		t.target = KnowledgeState;
		// action: set_var?var
		var trigger = new RoboChart!Communication;
		trigger.event = PlanDataSetEventsIface.events.select( ev | ev.name == ("set_" + v.name) ).first();
		trigger._type = RoboChart!CommunicationType#INPUT;
		trigger.value = new RefExp;
		trigger.value.ref = v;
		t.action = action;
		result.transitions.add(t);
		
		// ext_planData transitions
		var t = new RoboChart!Transition;
		t.name = v.name + "_ext_trans";
		t.source = KnowledgeState;
		t.target = KnowledgeState;
		// trigger: get_var_ext
		var trigger = new RoboChart!Communication;
		trigger.event = PlanDataExtEventsIface.events.select( ev | ev.name == ("get_" + v.name + "_ext") ).first();
		trigger._type = RoboChart!CommunicationType#SIMPLE;
		t.trigger = trigger;
