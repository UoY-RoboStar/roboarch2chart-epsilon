	if (amptn.legitimate <> null) {
		var PlanDataLegitimateEventsIface = ref(lyrName + "_PlanData_Legitimate_events", RoboChart!Interface);
		result.interfaces.add(PlanDataLegitimateEventsIface);
	
		for (v in PlanDataIface.variableList.collect( vl | vl.vars).flatten()) {
