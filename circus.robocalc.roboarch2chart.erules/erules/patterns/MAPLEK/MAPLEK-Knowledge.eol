			trigger.event = VerificationInfoPlanEventsIface.events.select( ev | ev.name == ("get_" + v.name + "_Plan") ).first();
			trigger._type = RoboChart!CommunicationType#SIMPLE;
			t.trigger = trigger;
			// action: var!var
