	if (amptn.legitimate <> null) {
		var VerificationInfoPlanEventsIface = ref(lyrName + "_VerificationInfo_Plan_events", RoboChart!Interface);
		result.interfaces.add(VerificationInfoPlanEventsIface);
	
		for (v in VerificationInfoIface.variableList.collect( vl | vl.vars).flatten()) {
