import "../../common/RoboChart.eol";

operation RecordedDataInterfaces(rdvr: Set(RoboArch!Variable), pat: RoboArch!MAPLEK, name: String): Set(RoboChart!Interface) {
	var result = Set{};
	
	// RecordedData
	var recordedDataIface = new RoboChart!Interface;
	recordedDataIface.name = name + "_RecordedData";
	for (v in rdvr) {
		var vl = new RoboChart!VariableList;
		vl.modifier = RoboChart!VariableModifier#VAR;
		var newVar = CreateRCVariable(v.name, v.type.clone());
		vl.vars.add(newVar);
		recordedDataIface.variableList.add(vl);
	}
	result.add(recordedDataIface);

	// RecordedData_events
	var recordedDataEventsIface = new RoboChart!Interface;
	recordedDataEventsIface.name = name + "_RecordedData_events";
	for (v in rdvr) {
		var ev = CreateRCEvent(v.name , v.type.clone());
		recordedDataEventsIface.events.add(ev);
		var ev = CreateRCEvent("get_" + v.name);
		recordedDataEventsIface.events.add(ev);
	}
	result.add(recordedDataEventsIface);
	
	// RecordedData_set_events
	var recordedDataSetEventsIface = new RoboChart!Interface;
	recordedDataSetEventsIface.name = name + "_RecordedData_set_events";
	for (v in rdvr) {
		var ev = CreateRCEvent("set_" + v.name, v.type.clone());
		recordedDataSetEventsIface.events.add(ev);
	}
	result.add(recordedDataSetEventsIface);
	
	// RecordedData_ext_events
	var recordedDataExtEventsIface = new RoboChart!Interface;
	recordedDataExtEventsIface.name = name + "_RecordedData_ext_events";
	for (v in rdvr) {
		var ev = CreateRCEvent(v.name + "_ext", v.type.clone());
		recordedDataExtEventsIface.events.add(ev);
		var ev = CreateRCEvent("get_" + v.name + "_ext");
		recordedDataExtEventsIface.events.add(ev);
	}
	result.add(recordedDataExtEventsIface);
	
	// RecordedData_Analyse_events
	if (pat.analyse != null) {
		var recordedDataAnalyseEventsIface = new RoboChart!Interface;
		recordedDataAnalyseEventsIface.name = name + "_RecordedData_Analyse_events";
		for (v in rdvr) {
			var ev = CreateRCEvent(v.name + "_Analyse", v.type.clone());
			recordedDataAnalyseEventsIface.events.add(ev);
			var ev = CreateRCEvent("get_" + v.name + "_Analyse");
			recordedDataAnalyseEventsIface.events.add(ev);
		}
		result.add(recordedDataAnalyseEventsIface);
	}
	
	// RecordedData_Plan_events
	if (pat.plan != null) {
		var recordedDataPlanEventsIface = new RoboChart!Interface;
		recordedDataPlanEventsIface.name = name + "_RecordedData_Plan_events";
		for (v in rdvr) {
			var ev = CreateRCEvent(v.name + "_Plan", v.type.clone());
			recordedDataPlanEventsIface.events.add(ev);
			var ev = CreateRCEvent("get_" + v.name + "_Plan");
			recordedDataPlanEventsIface.events.add(ev);
		}
		result.add(recordedDataPlanEventsIface);
	}
	
	// RecordedData_Legitimate_events
	if (pat.legitimate != null) {
		var recordedDataLegitimateEventsIface = new RoboChart!Interface;
		recordedDataLegitimateEventsIface.name = name + "_RecordedData_Legitimate_events";
		for (v in rdvr) {
			var ev = CreateRCEvent(v.name + "_Legitimate", v.type.clone());
			recordedDataLegitimateEventsIface.events.add(ev);
			var ev = CreateRCEvent("get_" + v.name + "_Legitimate");
			recordedDataLegitimateEventsIface.events.add(ev);
		}
		result.add(recordedDataLegitimateEventsIface);
	}
	
	return result;
}

