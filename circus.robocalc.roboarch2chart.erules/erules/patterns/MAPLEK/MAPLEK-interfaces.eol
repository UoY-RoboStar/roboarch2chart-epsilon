operation PlanDataInterfaces(pdvr: Set(RoboArch!Variable), pat: RoboArch!MAPLEK, name: String): Set(RoboChart!Interface) {
	var result = Set{};
	
	// PlanData
	var planDataIface = new RoboChart!Interface;
	planDataIface.name = name + "_PlanData";
	for (v in pdvr) {
