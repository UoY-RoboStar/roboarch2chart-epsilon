operation MAPLEKExecuteKnowledgeConnections(execute: RoboChart!StateMachineRef, knowledge: RoboChart!StateMachineRef, amptn: RoboArch!MAPLEK): Sequence(RoboChart!Connection) {
	var knowledge_events = knowledge.ref.interfaces.collect( iface | iface.events ).flatten();
