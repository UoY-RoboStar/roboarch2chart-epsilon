operation LayerToTypes(amlyr:RoboArch!Layer) : Set(RoboChart!TypeDecl) {
	printDebug("LayerToTypes - " + amlyr.name );
	var rctyp = Set{};
	
	if (amlyr.pattern <> null){ 
		rctyp.addAll( amlyr.equivalent("ReactiveSkillsLayerToTypes", "MAPLEKLayerToTypes") ); //Add supported patterns to this list.
	}
	
	return rctyp;
}


