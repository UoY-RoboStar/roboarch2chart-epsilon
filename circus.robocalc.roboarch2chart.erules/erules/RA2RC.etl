@lazy
rule ConnectionToConnection
	transform amctn: RoboArch!Connection
	to rcctn: RoboChart!Connection {
	
		rcctn.efrom = amctn.efrom.equivalent();
		rcctn.eto = amctn.eto.equivalent();
		rcctn.from = amctn.from.equivalent("RoboticPlatformRefToRoboticPlatformRef", "RoboticPlatformDefToRoboticPlatformDef", 
			"PlanningLayerToControllerRef", "ExecutiveLayerToControllerRef", "ControlLayerToControllerRef", "GenericLayerToControllerRef");
		rcctn.`to` = amctn.`to`.equivalent("RoboticPlatformRefToRoboticPlatformRef", "RoboticPlatformDefToRoboticPlatformDef",
			"PlanningLayerToControllerRef", "ExecutiveLayerToControllerRef", "ControlLayerToControllerRef", "GenericLayerToControllerRef");
		rcctn.`async` = amctn.`async`;
		rcctn.bidirec = amctn.bidirec;
	}

 
