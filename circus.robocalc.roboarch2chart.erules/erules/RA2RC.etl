@lazy
rule FunctionToFunction
	transform rafn: RoboArch!Function
	to rcfn: RoboChart!Function
	extends TypedNamedElementToTypedNamedElement{
	
		rcfn.parameters = rafn.parameters.equivalent();
	}
	
@lazy
rule ParameterToParameter
	transform rafn: RoboArch!Parameter
	to rcfn: RoboChart!Parameter
	extends TypedNamedElementToTypedNamedElement{
	
		// Handled by the abstract rule
	}
	
@lazy
rule OperationSigToOperationSig
	transform raop: RoboArch!OperationSig
	to rcop: RoboChart!OperationSig
	extends NamedElementToNamedElement {
		printDebug("Start " + raop.name);
		
		rcop.terminates = raop.terminates;
		rcop.parameters = raop.parameters.equivalent();
		rcop.preconditions = raop.preconditions.equivalent();
		rcop.postconditions = raop.postconditions.equivalent();
	}

@lazy
rule EventToEvent
	transform rpev: RoboArch!Event
	to rcev: RoboChart!Event 
	extends NamedElementToNamedElement{
	
 		printDebug("Start " + rpev.name);
		rcev.broadcast = rpev.broadcast;
		
		increaseDebug();
		rcev.type = rpev.type.equivalent();
		decreaseDebug();
	}
	
@lazy
rule TypeRefToTypeRef
	transform rptr: RoboArch!TypeRef
	to rctr: RoboChart!TypeRef{
		/* When called via equivalent only the same reference is returned each time
		   therefore ensure the TypeRef returned by equivalent is cloned. */
		
		rptr.ref.equivalent();
		
		printDebug("Start - " + rptr.ref.name + " - " + rptr.ref.eResource());
		
		
		if (rptr.ref.eResource().getURI().isPlatformPlugin()) {
			// probably from the RoboChart library, copy the reference as-is
			printDebug("Copying RoboChart library type");
			rctr.ref = rptr.ref;
		} else {
			increaseDebug();
			rctr.ref = rptr.ref.equivalent(); 
			decreaseDebug();
		}
		
		printDebug("End - " + rctr.ref.name + " - " + rctr.ref.eResource());
	}
	
	
@lazy
rule SeqTypeToSeqType
	transform rast: RoboArch!SeqType
	to rcst: RoboChart!SeqType {
		printDebug("Start");
		rcst.domain = rast.domain.equivalent();
	}

@lazy
rule ProductTypeToProductType
	transform rapt: RoboArch!ProductType
	to rcpt: RoboChart!ProductType {
		printDebug("Start");
		printDebug(rapt.types);
		rcpt.types = rapt.types.equivalent();
		printDebug(rcpt.types);
	}