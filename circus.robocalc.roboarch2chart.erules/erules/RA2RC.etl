rule SystemToRCModule
	transform amsys: RoboArch!System
	to rcsysPkg: RoboChart!RCPackage,
		rcdefsPkg: RoboChart!RCPackage {
		
		rcdefsPkg.name = DefinitionsName();
		
		//Where
		var cLayer = amsys.layers.select( lyr | lyr.isTypeOf(RoboArch!ControlLayer) );
		printDebug(amsys.robot);
		var roboticPlatform;
		if ( amsys.robot != null and 
			((amsys.robot.operations.size() > 0) or (amsys.robot.interfaces.size() > 0) or 
		     (amsys.robot.pinterfaces.size() > 0) or (amsys.robot.variableList.size() > 0)) ) {
		    printDebug("Adding robotic platform: " + amsys.robot);
			roboticPlatform = amsys.robot.equivalent();
			printDebug("roboticPlatform: " + roboticPlatform);
		} else {
			printDebug("Adding robotic platform based on controller: " + cLayer);
			roboticPlatform = roboticPlatform.add(ControlLayerToRoboticPlatform(cLayer));
		}

		
		//Definitions
		rcdefsPkg.types = amsys.definitions.equivalent();
						for (lyr: RoboArch!Layer in amsys.layers){
							rcdefsPkg.types.addAll( LayerToTypes(lyr) );
						}
		printDebug("Definitions: " + rcdefsPkg.types);
						
		//Functions
		rcdefsPkg.functions = amsys.functions.equivalent();
						for (lyr: RoboArch!Layer in amsys.layers){
							rcdefsPkg.functions.addAll( LayerToFunctions(lyr) );
						}
		printDebug("Functions: " + rcdefsPkg.functions);
					
		//Interfaces	
		rcdefsPkg.interfaces = amsys.interfaces.equivalent();
						for (lyr: RoboArch!Layer in amsys.layers){
							rcdefsPkg.interfaces.addAll( LayerToInterface(lyr) );
						}
		printDebug("Interfaces: " + rcdefsPkg.interfaces);
		
		//Module
		var rcmod = new RoboChart!RCModule;
		
			rcmod.name = amsys.name;
			
			//Module nodes = the union of controllers and the roboticplatform
			printDebug(amsys.layers);
			rcmod.nodes = amsys.layers.equivalent("PlanningLayerToControllerRef", "ExecutiveLayerToControllerRef", "ControlLayerToControllerRef", "GenericLayerToControllerRef");
			var n = 0;
			for (node in rcmod.nodes) {
				node.name = "ctrl_ref" + n;
				n = n+1;
			}
			printDebug("Robotic platform: " + roboticPlatform);
			rcmod.nodes.add(roboticPlatform);

			printDebugControllerSummary(rcmod.nodes);
			
			rcmod.connections = amsys.connections.equivalent();
		
		//Populate system package
		rcsysPkg.name = amsys.name;
		
		if( amsys.layers.exists( lyr | lyr.isTypeOf(RoboArch!ControlLayer) and lyr.pattern.isDefined() ) ){
			rcsysPkg.imports.add( getPackageImport(PlatformName()) );
		}
		for(lyr: RoboArch!Layer in amsys.layers){
			rcsysPkg.imports.add( getPackageImport(lyr.name.toLowerCase().firstToUpperCase() ) );
		}
		rcsysPkg.imports.add( getPackageImport( DefinitionsName() ) );
		
		rcsysPkg.modules.add(rcmod);
		
//		var rs = rcdefsPkg.eResource().getResourceSet();
//		var uri = rcdefsPkg.eResource().getUri().trimSegments(1).appendSegment(rcdefsPkg.name + ".rct");
//		var r = rs.createResource(uri);
//		r.getContents().add(rcdefsPkg);
	}
	
@lazy
rule RoboticPlatformRefToRoboticPlatformRef
	transform rarpr: RoboArch!RoboticPlatformRef
	to rcrpr: RoboChart!RoboticPlatformRef
	extends NamedElementToNamedElement {
		printDebug("Start");
	
		rcrpr.ref = rarpr.ref.equivalent();
	}
	
@abstract
rule BasicContextToBasicContext
	transform ractxt: RoboArch!BasicContext
	to rcctxt: RoboChart!BasicContext {
		printDebug("Start");
	
		rcctxt.variableList = ractxt.variableList.equivalent();
		rcctxt.operations = ractxt.operations.equivalent();
		rcctxt.events = ractxt.events.equivalent();
		rcctxt.clocks = ractxt.clocks.equivalent();
		
		
	}

@abstract
rule ContextToContext
	transform ractxt: RoboArch!RoboticPlatformDef
	to rcctxt: RoboChart!RoboticPlatformDef
	extends BasicContextToBasicContext {
		printDebug("Start");
		
		rcctxt.pInterfaces = ractxt.pInterfaces.equivalent();
		rcctxt.rInterfaces = ractxt.rInterfaces.equivalent();
		rcctxt.interfaces = ractxt.interfaces.equivalent();
	}
	
@lazy
rule RoboticPlatformDefToRoboticPlatformDef
	transform rarpd: RoboArch!RoboticPlatformDef
	to rcrpd: RoboChart!RoboticPlatformDef
	extends ContextToContext {
		printDebug("Start");
		
		rcrpd.name = rarpd.name;
	}
	
@lazy
rule InterfaceToInterface
	transform raifc: RoboArch!Interface
	to rcifc: RoboChart!Interface
	extends BasicContextToBasicContext {
		printDebug("Start - " + raifc.name);
		
		rcifc.name = raifc.name;
	}
	
@abstract
rule LayerToControllerRef
	transform amlyr: RoboArch!Layer 
	to rcctrl: RoboChart!ControllerRef {
		printDebug("Start - " + amlyr.name);
		rcctrl.ref = amlyr.equivalent("PlanningLayerToControllerDef", "ExecutiveLayerToControllerDef", "ControlLayerToControllerDef", "GenericLayerToControllerDef");
	}
@lazy
rule PlanningLayerToControllerRef
	transform amlyr: RoboArch!PlanningLayer 
	to rcctrl: RoboChart!ControllerRef 
	extends LayerToControllerRef {
	}
@lazy
rule ExecutiveLayerToControllerRef
	transform amlyr: RoboArch!ExecutiveLayer 
	to rcctrl: RoboChart!ControllerRef 
	extends LayerToControllerRef {
	}
@lazy
rule ControlLayerToControllerRef
	transform amlyr: RoboArch!ControlLayer 
	to rcctrl: RoboChart!ControllerRef 
	extends LayerToControllerRef {
	}
@lazy
rule GenericLayerToControllerRef
	transform amlyr: RoboArch!GenericLayer 
	to rcctrl: RoboChart!ControllerRef 
	extends LayerToControllerRef {
	}

@abstract
rule LayerToControllerDef
	transform amlyr: RoboArch!Layer 
	to rcctrl: RoboChart!ControllerDef {
		printDebug("Start - " + amlyr.name);

		rcctrl.name = amlyr.name;
		
		rcctrl.events = Sequence{};
		increaseDebug();
		rcctrl.events.addAll(amlyr.inputs.equivalent());
		rcctrl.events.addAll(amlyr.outputs.equivalent());
		decreaseDebug();
		
		increaseDebug();
		var stmsConns = LayerToStateMachinesAndConnections(amlyr);
		rcctrl.machines = stmsConns.machines;
		rcctrl.connections = stmsConns.connections;
		decreaseDebug();
		
		if (amlyr.isKindOf(RoboArch!ControlLayer) or amlyr.isKindOf(RoboArch!GenericLayer)) {
			increaseDebug();
			rcctrl.interfaces = amlyr.interfaces.equivalent();
			decreaseDebug();
			printDebug("Interfaces: " + rcctrl.interfaces);
			for (iface in rcctrl.interfaces) {
				printDebug("\t" + iface + " - " + iface.eContainer());
			}
			increaseDebug();
			rcctrl.rInterfaces = amlyr.rinterfaces.equivalent();
			decreaseDebug();
			printDebug("Required Interfaces: " + rcctrl.rInterfaces);
		} else {
			rcctrl.interfaces = Set{};
			rcctrl.rInterfaces = Set{};
		}
		
		// make controller package
		var rcpkg = new RoboChart!RCPackage;
		rcpkg.name = amlyr.name.toLowerCase().firstToUpperCase();
		rcpkg.controllers = Set{};
		rcpkg.controllers.add(rcctrl);
		
		var packageImport = new RoboChart!Import;
		packageImport.importedNamespace = amlyr.eContainer().name + rc_importall();
		printDebug(rcpkg.name + ": adding import of " + packageImport.importedNamespace);
		rcpkg.imports.add( packageImport );
		rcpkg.imports.addAll(stmsConns.imports);
		
	}
@lazy
rule PlanningLayerToControllerDef
	transform amlyr: RoboArch!PlanningLayer 
	to rcctrl: RoboChart!ControllerDef 
